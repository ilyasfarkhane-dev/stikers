# ---------- Admin dashboard (/admin) ----------
# ADMIN_PASSWORD: at least 8 characters. On Sites hosting, set it as a secret in the Sites panel.
ADMIN_PASSWORD=
# Optional: secret used to sign admin sessions (defaults to a value derived from ADMIN_PASSWORD).
SESSION_SECRET=

# ---------- Database ----------
# mysql  = MySQL / MariaDB (XAMPP locally, your own server in production).
#          The database is created automatically if it does not exist.
# sqlite = local file database (same engine as Sites hosting).
# On Sites hosting none of this is used: the built-in D1 database from
# .openai/hosting.json ("d1": "DB") is provided automatically.
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=stickarts

# Only used when DB_CLIENT=sqlite (relative to backend/).
DB_PATH=.data/dev.sqlite

# ---------- Uploaded customer files (relative to backend/) ----------
FILES_DIR=.data/files

# ---------- Standalone server (npm start) ----------
PORT=8080
